{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@timmo001/oxlint-rules",
  "version": "0.2.1",
  "exports": {
    "./upstream/anti-slop": "./src/jsr/upstream-anti-slop.ts",
    "./upstream/effect": "./src/jsr/upstream-effect.ts",
    "./generic": "./src/jsr/generic.ts",
    "./effect": "./src/jsr/effect.ts",
    "./configs/recommended": "./src/jsr/recommended.ts",
    "./configs/recommended-effect": "./src/jsr/recommended-effect.ts"
  },
  "publish": {
    "include": [
      "dist/upstream/*.js",
      "dist/generic/index.js",
      "dist/effect/index.js",
      "dist/configs/*.js",
      "src/jsr/**/*.ts",
      "vendor/anti-slop/LICENSE",
      "LICENSE",
      "README.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "exclude": ["!dist"]
  }
}
